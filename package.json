{
  "name": "min",
  "productName": "Min",
  "author": "PalmerAL",
  "version": "1.39.11",
  "description": "A fast, minimal browser that protects your privacy",
  "electronVersion": "41.2.0",
  "main": "main.build.js",
  "standard": {
    "globals": [
      "throttle",
      "debounce",
      "empty",
      "alert",
      "confirm",
      "requestAnimationFrame",
      "requestIdleCallback",
      "fetch",
      "localStorage",
      "performance",
      "IntersectionObserver",
      "Node",
      "Event"
    ]
  },
  "dependencies": {
    "@electron/fuses": "^1.8.0",
    "cherry-markdown": "0.11.10",
    "chokidar": "^3.6.0",
    "dexie": "^3.0.3",
    "dragula": "github:minbrowser/dragula",
    "electron-squirrel-startup": "^1.0.0",
    "expr-eval": "^2.0.2",
    "quick-score": "^0.2.0",
    "regedit": "^3.0.3",
    "sortablejs": "^1.15.1",
    "stemmer": "^1.0.5",
    "write-file-atomic": "^6.0.0"
  },
  "devDependencies": {
    "@embedpdf/models": "2.14.2",
    "@embedpdf/snippet": "2.14.2",
    "archiver": "^4.0.1",
    "browserify": "^16.5.1",
    "concurrently": "^5.2.0",
    "electron": "41.2.0",
    "electron-builder": "^24.13.3",
    "electron-installer-windows": "^3.0.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^2.2.1",
    "snazzy": "^9.0.0",
    "standard": "^14.3.4"
  },
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node ./scripts/setupDevEnv.js",
    "test": "npm run test:node && npm run lint:js",
    "test:electron-performance": "npm run buildPreload && electron --no-sandbox test/electronPerformance.js",
    "test:node": "node --test test/*.test.js",
    "test:electron-vault": "electron test/electronVault.js",
    "test:electron-vault-pages": "npm run buildPDFViewer && electron test/electronVaultPages.js",
    "test:electron-pdf-bundle": "npm run buildPDFViewer && electron --no-sandbox test/electronPDFBundle.js",
    "test:electron-vault-app": "electron test/electronVaultApp.js",
    "test:electron-settings": "electron test/electronSettings.js",
    "lint:js": "standard --verbose \"js/**/*.js\" \"main/**/*.js\" \"test/**/*.js\" \"pages/markdown/*.js\" \"pages/vault/*.js\" \"pages/pdfViewer/*.js\" pages/settings/vaultSettings.js",
    "watch": "node ./scripts/watch.js",
    "startElectron": "electron . --development-mode",
    "start": "npm run build && concurrently \"npm run watch\" \"npm run startElectron\"",
    "buildMain": "node ./scripts/buildMain.js",
    "buildBrowser": "node ./scripts/buildBrowser.js",
    "buildBrowserStyles": "node ./scripts/buildBrowserStyles.js",
    "buildPreload": "node ./scripts/buildPreload.js",
    "buildPDFViewer": "node ./scripts/buildPDFViewer.js",
    "build": "npm run buildMain && npm run buildBrowser && npm run buildBrowserStyles && npm run buildPreload && npm run buildPDFViewer",
    "benchmark:performance": "node scripts/benchmarkPerformance.js",
    "buildWindows": "npm run build && node ./scripts/buildWindows.js",
    "buildMacIntel": "npm run build && node ./scripts/buildMac.js --platform=x86",
    "buildMacArm": "npm run build && node ./scripts/buildMac.js --platform=arm64",
    "buildDebian": "npm run build && node ./scripts/buildDebian.js --platform=amd64",
    "buildRedhat": "npm run build && node ./scripts/buildRedhat.js",
    "buildAll": "npm run buildWindows && npm run buildMacIntel && npm run buildMacArm && npm run buildDebian && npm run buildRedhat && npm run buildAppImage",
    "buildAppImage": "npm run build && node ./scripts/buildAppImage.js",
    "updateFilters": "node ./ext/filterLists/updateEasylist.js",
    "updateHttpsList": "node ./ext/httpsUpgrade/updateHttpsList.js",
    "updateSuffixes": "node ./ext/publicSuffixes/updateSuffixes.js",
    "lint": "npm run format",
    "format": "prettier --write \"**/*.css\" \"**/*.md\" \"**/*.html\" \"**/*.json\" && standard --fix \"js/**/*.js\" \"main/**/*.js\" \"test/**/*.js\" | snazzy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minbrowser/min.git"
  }
}
